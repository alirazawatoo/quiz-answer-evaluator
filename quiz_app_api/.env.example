# Export these variables in the process environment; .env is not loaded automatically.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is not true. Use a long random string.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional; defaults to quiz_app_api/db.sqlite3
# DJANGO_SQLITE_PATH=/path/to/db.sqlite3
